# ==============================================================================
# Document Extractor — Production Environment Configuration
# ==============================================================================

# Application Environment Mode
# Values: production, staging, development
ENVIRONMENT=production

# API Documentation & Schema Exposure
# Set to 'false' in production to disable public /docs, /redoc, and /openapi.json
ENABLE_DOCS=false

# Authentication
# In production, REQUIRE_API_KEY=true enforces that API_KEY is set and non-empty.
# Clients must send this key in the 'X-API-Key' HTTP request header.
REQUIRE_API_KEY=true
API_KEY=your-secure-random-32-char-api-key-here

# Security & Network Protection
# Enables SSRF protection: blocks private IPs (RFC1918), loopback, link-local,
# cloud metadata (169.254.169.254), carrier-grade NAT, and disallowed ports.
ENABLE_SSRF_PROTECTION=true

# Concurrency & Resource Limits
# ThreadPoolExecutor size per worker process for CPU-intensive document parsing.
MAX_WORKERS=4

# Maximum concurrent HTTP downloads across all workers.
MAX_CONCURRENT_DOWNLOADS=10

# Network Timeouts (seconds)
DOWNLOAD_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=120

# Maximum input document size allowed (Megabytes)
MAX_FILE_SIZE_MB=50

# Cache Configuration
# In-memory extraction cache TTL (seconds)
CACHE_TTL_SECONDS=3600

# OCR Fallback Configuration (Tesseract + PyMuPDF)
ENABLE_OCR_FALLBACK=true
OCR_LANGUAGE=eng
OCR_CHARS_PER_PAGE_THRESHOLD=50

# Logging Level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
